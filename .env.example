# Configuración de Contenedores e Infraestructura
MSSQL_SA_PASSWORD=YourStrong@Pass123!

# Configuración de ASP.NET Core & RAG
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=EnterpriseRagDb;User Id=sa;Password=YourStrong@Pass123!;TrustServerCertificate=True;
ConnectionStrings__IdentityConnection=Server=sqlserver,1433;Database=EnterpriseRagIdentityDb;User Id=sa;Password=YourStrong@Pass123!;TrustServerCertificate=True;

VectorStore__Endpoint=http://qdrant:6334
VectorStore__ApiKey=

Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE
Gemini__Model=gemini-2.5-flash
Gemini__EmbeddingModel=gemini-embedding-001

Jwt__Secret=SuperSecretKeyWithAtLeast32BytesLengthForSecurityCompliance!
Jwt__Issuer=EnterpriseRagApi
Jwt__Audience=EnterpriseRagClient
Jwt__ExpiryMinutes=60
