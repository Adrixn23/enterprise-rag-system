# =================================================================
# ENTERPRISE RAG SYSTEM - PLANTILLA DE VARIABLES DE ENTORNO
# =================================================================
# Copiar este archivo a `.env` para uso local y reemplazar los valores
# de ejemplo. Nunca subir `.env` ni credenciales reales al repositorio.

# 1. Base de datos SQL Server 2022
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SQL_PASSWORD!

# 2. Cadenas de Conexión de ASP.NET Core
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=EnterpriseRagDb;User Id=sa;Password=REPLACE_WITH_STRONG_SQL_PASSWORD!;TrustServerCertificate=True;MultipleActiveResultSets=true;
ConnectionStrings__IdentityConnection=Server=localhost,1433;Database=EnterpriseRagIdentityDb;User Id=sa;Password=REPLACE_WITH_STRONG_SQL_PASSWORD!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# 3. Base de Datos Vectorial Qdrant
QdrantSettings__Host=localhost
QdrantSettings__Port=6334
QdrantSettings__ApiKey=
QdrantSettings__CollectionName=enterprise-documents

# 4. Google Gemini API (Embeddings 768d y LLM Generativo)
GeminiSettings__ApiKey=REPLACE_WITH_GEMINI_API_KEY
GeminiSettings__ModelId=gemini-embedding-001
GeminiSettings__EmbeddingDimension=768
GeminiSettings__GenerationModelId=gemini-3.5-flash-lite

# 5. Seguridad JWT (HMAC-SHA256 con clave simétrica >= 32 bytes)
JWTSettings__Key=REPLACE_WITH_MIN_32_BYTE_SECRET_KEY_FOR_HMAC_SHA256!
JWTSettings__Issuer=EnterpriseRagApi
JWTSettings__Audience=EnterpriseRagClient
JWTSettings__DurationInMinutes=60

# 6. Correo y Confirmación de Cuenta (obligatorio fuera de Development)
EmailSettings__PublicBaseUrl=https://rag.example.com
EmailSettings__Host=smtp.example.com
EmailSettings__Port=587
EmailSettings__UserName=REPLACE_WITH_SMTP_USERNAME
EmailSettings__Password=REPLACE_WITH_SMTP_PASSWORD
EmailSettings__FromEmail=no-reply@example.com
EmailSettings__FromName=Enterprise RAG System
