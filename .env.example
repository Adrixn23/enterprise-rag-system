# =================================================================
# ENTERPRISE RAG SYSTEM - VARIABLES DE ENTORNO
# =================================================================

# 1. Base de datos SQL Server 2022
MSSQL_SA_PASSWORD=ConfiguraUnPasswordFuerteDeAlMenos8Caracteres!

# 2. Cadenas de Conexión de ASP.NET Core
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=EnterpriseRagDb;User Id=sa;Password=ConfiguraUnPasswordFuerteDeAlMenos8Caracteres!;TrustServerCertificate=True;MultipleActiveResultSets=true;
ConnectionStrings__IdentityConnection=Server=localhost,1433;Database=EnterpriseRagIdentityDb;User Id=sa;Password=ConfiguraUnPasswordFuerteDeAlMenos8Caracteres!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# 3. Base de Datos Vectorial Qdrant
QdrantSettings__Host=localhost
QdrantSettings__Port=6334
QdrantSettings__ApiKey=
QdrantSettings__CollectionName=enterprise-documents

# 4. Google Gemini API (Embeddings y LLM Generativo)
GeminiSettings__ApiKey=TU_API_KEY_DE_GOOGLE_GEMINI_AQUI
GeminiSettings__ModelId=gemini-embedding-001
GeminiSettings__EmbeddingDimension=768
GeminiSettings__GenerationModelId=gemini-2.5-flash

# 5. Seguridad JWT (HMAC-SHA256 con clave simétrica >= 32 bytes)
JWTSettings__Key=TuClaveSecretaJWTDeAlMenos32BytesDeEntropia123456789!
JWTSettings__Issuer=EnterpriseRagApi
JWTSettings__Audience=EnterpriseRagClient
JWTSettings__DurationInMinutes=60
